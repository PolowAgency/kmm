# Supabase project used by kmm-mobile is kmmtradehub (lazuufpwgzzaxjplrzpa) — see ARCHITECTURE.md §3.
# This is a *different* Supabase project than TERMINAL's.
#
# Get real values from: Supabase Dashboard > kmmtradehub project > Project Settings > API
# (or copy NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY from kmmtradehub/.env.local —
# these are public/publishable client credentials, safe to embed in a mobile app).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
